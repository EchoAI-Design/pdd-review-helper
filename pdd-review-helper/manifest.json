{
  "manifest_version": 3,
  "name": "评价巡检助手 · 拼多多",
  "version": "0.4.0",
  "description": "查询近30天1—3星评价，统一批量处理已核验记录并保存结果；平台提交须手动确认。",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://mms.pinduoduo.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "打开评价巡检助手" },
  "content_scripts": [{
    "matches": ["https://mms.pinduoduo.com/*"],
    "js": ["core.js", "adapter.js", "scanner.js", "shop.js", "reporter.js", "batch.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["app.html", "app.css", "panel.css", "query.css", "app.js", "core.js"],
    "matches": ["https://mms.pinduoduo.com/*"]
  }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
